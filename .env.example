# ============================================================
# Observability Platform — Example Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=observability
DATABASE_URL=postgresql://user:password@db:5432/observability

# --- Auth ---
JWT_SECRET=fake-jwt-secret-replace-in-env-do-not-use-in-prod
JWT_EXPIRY_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173

# Admin seed (used by scripts/seed_admin.py — never use defaults in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEEDING

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=fake-smtp-app-password
SMTP_FROM_EMAIL=alerts@example.com
SMTP_FROM_NAME=AetherPulse Cloud Observability
SMTP_USE_TLS=true

# --- Prometheus ---
PROMETHEUS_URL=http://prometheus:9090

# --- Detection Engine ---
DETECTION_INTERVAL_SECONDS=15
DETECTION_CONSECUTIVE_BREACHES=3
DETECTION_RECOVERY_CHECKS=3
CPU_THRESHOLD_PCT=80.0
MEM_THRESHOLD_PCT=85.0
DISK_THRESHOLD_PCT=90.0
LATENCY_P95_THRESHOLD_SECONDS=0.5
ERROR_RATE_THRESHOLD_PCT=5.0
# CONTAINER_RESTART_THRESHOLD: strictly greater than (e.g., 1 means breach on >1 restarts in window)
CONTAINER_RESTART_THRESHOLD=1
CONTAINER_RESTART_WINDOW_MINUTES=15
DEMO_DATA_DIR_BYTES_THRESHOLD=104857600.0

# --- AI / Gemini ---
GEMINI_API_KEY=fake-gemini-api-key-replace-in-env
GEMINI_MODEL=gemini-1.5-pro
LLM_TIMEOUT_SECONDS=30

# --- Port overrides (host ↔ container) ---
# Uncomment and change if default host ports conflict with existing services
# WORKLOAD_HOST_PORT=8081

# --- Legacy / other services ---
LOKI_URL=http://loki:3100
AGENT_SHARED_SECRET=fake-agent-shared-secret-replace-in-env
MODEL_PATH=/models/isolation_forest.pkl
ANOMALY_THRESHOLD=0.95
CORRELATION_WINDOW_MINUTES=15
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- S1 Demo Stack (docker-compose.demo.yml) ---
DEMO_DB_USER=demouser
DEMO_DB_PASSWORD=demopassword
DEMO_DB_NAME=demodb
DEMO_DB_HOST_PORT=5434
FAULT_TOKEN=demo-fault-secret-key
DEMO_DATA_DIR=/data/fill
